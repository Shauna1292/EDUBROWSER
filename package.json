{
  "name": "edubrowser",
  "version": "0.1.0",
  "description": "A browser built for learning, teaching, and focus.",
  "main": "main.js",
  "scripts": {
    "watch:renderer": "vite --port 5173",
    "start:electron": "electron .",
    "dev": "concurrently \"npm:watch:renderer\" \"wait-on http://localhost:5173 && npm:run start:electron\""
  },
  "author": "Keith Nyarunda",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.2",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  }
  ,
  "overrides": {
    "tar": "7.5.7"
  }
}
